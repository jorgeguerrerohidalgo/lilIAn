# =============================================================================
# lilIAn — Plantilla de variables de entorno (desarrollo)
# =============================================================================
#
# Renombra este archivo a `.env` (en la raíz del repo) y rellena los valores.
# Los `*.example` se versionan; los `.env` reales NO (ver `.gitignore`).
#
# Referencia completa con descripciones, defaults y validaciones:
#   docs/env-vars.md
#
# Cómo se cargan las variables en el backend:
#   - Fuente: apps/backend/app/core/config.py (pydantic-settings)
#   - Sensible a mayúsculas (`DATABASE_URL` != `database_url`)
#   - Variables extra no rompen el arranque (`extra = "ignore"`),
#     pero los typos pasan silenciosos: verifica los nombres contra env-vars.md
#
# =============================================================================
# Aplicación
# =============================================================================

# Entorno de ejecución. `production` activa validaciones estrictas
# (ALLOWED_ORIGINS sin wildcard, JWT_SECRET mínimo 32 caracteres).
APP_ENV=development

# Modo debug. Mantener en `false` en producción.
DEBUG=true

# Nivel de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Base de datos y Supabase
# =============================================================================

# Cadena de conexión PostgreSQL (requerida; sin default).
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# URL del proyecto Supabase. Necesaria si STORAGE_BACKEND=supabase.
SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Clave pública (anon). Segura para exponer al cliente (con RLS adecuado).
SUPABASE_ANON_KEY=replace_me_with_anon_key

# Clave de service role. SALTA RLS. Backend ONLY. Nunca al navegador.
SUPABASE_SERVICE_ROLE_KEY=replace_me_with_service_role_key_backend_only

# =============================================================================
# Redis
# =============================================================================

# Conexión Redis (cache, contadores). Default: redis del docker-compose.
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Seguridad y JWT
# =============================================================================

# Clave HMAC para firmar access tokens. Mínimo 32 caracteres aleatorios.
# En APP_ENV=production el arranque falla con cualquier placeholder.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_me_with_secure_random_string

# Algoritmo de firma JWT.
JWT_ALGORITHM=HS256

# Claims iss/aud emitidos y validados por el backend.
JWT_ISSUER=lilian
JWT_AUDIENCE=lilian-api

# Vigencia del access token en MINUTOS. El default del código es 86400
# minutos (≈60 días). Para 24 horas usa 1440.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Clave de cifrado en reposo. Declarada pero NO leída por el código actual
# (reservada para cifrado en reposo, aún no implementado). Se mantiene
# documentada para preparar el despliegue.
ENCRYPTION_KEY=replace_me_with_secure_random_string

# =============================================================================
# CORS
# =============================================================================

# Lista de orígenes permitidos separada por comas.
# Default: http://localhost:3000 (frontend de desarrollo).
# Producción: dominios explícitos, SIN wildcard (`*`) ni `null`.
# El arranque falla en producción si la lista está vacía o contiene `*`/`null`.
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# LLM (modelo principal)
# =============================================================================

# Proveedor: openai | anthropic | minimax
LLM_PROVIDER=anthropic

# Modelo concreto. Debe corresponder al proveedor seleccionado.
#   openai     -> gpt-4o-mini, gpt-4o, ...
#   anthropic  -> claude-sonnet-4-20250514, claude-opus-4-7, ...
#   minimax    -> MiniMax-Text-01
LLM_MODEL=claude-sonnet-4-20250514

# API key del proveedor LLM. Si está vacía, se usa OPENAI_API_KEY como fallback.
LLM_API_KEY=replace_me

# Fallback alternativo para LLM/embeddings (OpenAI).
OPENAI_API_KEY=replace_me

# =============================================================================
# Embeddings
# =============================================================================

# Proveedor de embeddings para búsqueda semántica (RAG).
EMBEDDING_PROVIDER=openai

# Modelo de embeddings. Default recomendado: text-embedding-3-small.
EMBEDDING_MODEL=text-embedding-3-small

# API key específica. Si está vacía, cae en OPENAI_API_KEY y luego en LLM_API_KEY.
EMBEDDING_API_KEY=replace_me

# =============================================================================
# Almacenamiento de documentos
# =============================================================================

# Backend de almacenamiento: local | supabase
# (Nota histórica: .env.example usaba STORAGE_PROVIDER. El código lee
# STORAGE_BACKEND. Mantén este nombre.)
STORAGE_BACKEND=local

# Raíz del almacenamiento local. Se normaliza con os.path.realpath y se usa
# como jaula anti path-traversal. Solo aplica si STORAGE_BACKEND=local.
STORAGE_PATH=/app/storage/documents

# Bucket cuando STORAGE_BACKEND=supabase. La plantilla histórica usaba
# `legal-documents`; el default del código es `documents`.
SUPABASE_STORAGE_BUCKET=legal-documents

# =============================================================================
# Rate limiting y uploads
# =============================================================================

# Límite por minuto del plan (default global). Aplicado por
# OrganizationRateLimitMiddleware según el plan efectivo.
RATE_LIMIT_PER_MINUTE=60

# Límite por minuto para endpoints de autenticación.
# Nota: el código usa literales `@limiter.limit("10/minute")`, no esta variable.
RATE_LIMIT_AUTH_PER_MINUTE=10

# Tamaño máximo de archivo en bytes (default 50 MB).
# Nota: documents.py define MAX_FILE_SIZE a nivel de módulo; cambiar esta
# variable sin tocar el código no altera el límite de upload.
MAX_FILE_SIZE=52428800

# =============================================================================
# Frontend (apps/frontend/.env.local)
# =============================================================================
#
# Estas variables NO se cargan en este archivo: van en
# `apps/frontend/.env.local` (gitignored). Se documentan aquí como
# referencia.
#
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Cualquier variable con prefijo NEXT_PUBLIC_ queda embebida en el bundle
# del navegador. Nunca pongas secretos aquí.
