# Production Environment Variables
# Copy this file to .env.production and fill in the values

APP_ENV=production
DEBUG=false

# Supabase - Production Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Redis
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=generate_a_secure_random_string_here_at_least_32_chars

# LLM Provider (anthropic, openai, minimax)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
# Para MiniMax usar: LLM_MODEL=MiniMax-Text-01
LLM_API_KEY=your_api_key

# Embedding Provider
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your_openai_api_key

# Storage
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=legal-documents

# CORS - Add your production domains
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---------------------------------------------------------------------------
# Sprint 2: Billing surface
# ---------------------------------------------------------------------------
# Stripe (self-service Checkout + webhook).
# All optional in dev — endpoints return 503 "Stripe no configurado" if unset.
# Get the secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Get the webhook secret from `stripe listen --forward-to ...` output, or
# the dashboard "Webhooks" section. Required to verify webhook signatures.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Price IDs, one per paid plan. Create them in the Stripe dashboard
# or via `stripe products create` + `stripe prices create`.
STRIPE_PRICE_LAWYER=price_xxx
STRIPE_PRICE_LAW_FIRM=price_xxx
STRIPE_PRICE_COMPANY=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# Resend (transactional email).
# Optional in dev — emails log-stub when RESEND_API_KEY is unset.
# Get the key from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM_ADDRESS=noreply@lilian.cl
EMAIL_FROM_NAME=Lilian

# Frontend base URL used by the Stripe Checkout success/cancel redirects
# and the Billing Portal return URL.
FRONTEND_BASE_URL=https://lil-i-5tz56uhov-jorgeguerrerohidalgo710.vercel.app
